# GCP / Firestore + Vertex AI (Gemini) — mismas credenciales que usa gcp_whatsapp
# Autenticación via ADC: gcloud auth application-default login
PROJECT_ID=your-gcp-project-id
DATABASE_NAME=agent-whatsapp-chats-database
# Opcional: path a service account JSON. Si está en GCP/Cloud Run, dejar vacío (usa ADC)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Twilio — alertas SMS
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Umbral de score para disparar alerta (0.0 - 1.0)
RISK_THRESHOLD=0.7
