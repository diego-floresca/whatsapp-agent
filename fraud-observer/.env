# GCP / Firestore + Vertex AI (Gemini) — mismo proyecto que el bot
# Credenciales via ADC: gcloud auth application-default login
PROJECT_ID=lunatic-analytics
DATABASE_NAME=agent-whatsapp-chats-database

# Twilio — alertas SMS (opcional para el demo, si no tienes déjalo así)
TWILIO_ACCOUNT_SID=REEMPLAZAR
TWILIO_AUTH_TOKEN=REEMPLAZAR
TWILIO_FROM_NUMBER=+16204140329

# Umbral de score para disparar alerta
RISK_THRESHOLD=0.7
